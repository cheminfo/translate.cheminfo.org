{
  "name": "translate-backend",
  "version": "0.0.0",
  "description": "Validates translation contributions and opens the pull requests",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "start": "node --env-file-if-exists=../.env src/server.ts",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@octokit/rest": "^22.0.1",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.4",
    "react-cheminfo": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@zakodium/tsconfig": "^1.0.5",
    "vitest": "^5.0.0"
  }
}
