# The package this repository publishes; the deploy script pulls or builds it.
IMAGE_NAME=ghcr.io/cheminfo/translate.cheminfo.org
# Rewritten by the server's deploy script on every deploy; never edit by hand.
IMAGE_TAG=latest

# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# Port on which the service listens. The Vite dev server uses PORT + 1.
PORT=10914

# The reverse proxies whose X-Forwarded-For is believed: an address, a CIDR
# range, or a comma separated list of either. The contribution rate limit is
# counted per client address, so behind a proxy this must name it.
# TRUST_PROXY=192.168.1.5

# Token of the bot account that opens the pull requests: a classic personal
# access token with the `public_repo` scope. The bot pushes a branch where it
# has write access and works from a fork everywhere else. Unset disables
# submitting; the overlay still offers the translation as a download.
# GITHUB_TOKEN=

# Signs the token that lets a translator add to the pull request they opened.
# openssl rand -hex 32
CONTRIBUTION_SECRET=

# The repositories a pull request may be opened on, as comma separated
# `owner/repo` patterns where `*` stands for any repository of that owner.
ALLOWED_REPOSITORIES=cheminfo/*

# How many contributions one client address may submit per hour.
CONTRIBUTIONS_PER_HOUR=20

# Cloudflare Tunnel token (only required for the cloudflared compose variant).
# TUNNEL_TOKEN=
